NODE_ENV=development
PORT=8080

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bookmyshow

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# Comma separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173

# Number of proxies in front of the app (Render = 1). 0 disables trust proxy.
TRUST_PROXY=0

# Seat hold duration while selecting seats (minutes)
SEAT_HOLD_MINUTES=5

# Razorpay (test mode keys from https://dashboard.razorpay.com/app/keys)
# Leave blank locally to use the built-in mock payment flow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret configured on the Razorpay webhook (Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=
# Allow the mock payment flow in production (demo deployments only)
ALLOW_MOCK_PAYMENTS=false

# HMAC secret for ticket QR codes (defaults to JWT_SECRET)
TICKET_SECRET=

# Transactional email via Brevo HTTP API (https://app.brevo.com -> SMTP & API -> API keys)
# Leave blank locally: emails are printed to the console instead.
BREVO_API_KEY=
# Must be a sender verified in Brevo
EMAIL_FROM=
EMAIL_FROM_NAME=BookMyShow
